# Copy this file to .env and fill in what you need. Never commit .env.

# Which component reads questions: auto | gemini | ollama | rules
# auto uses Gemini if a key is set, else Ollama if it is running, else the rule-based parser.
ECOMETRIC_PROVIDER=auto

# Gemma 4 through the Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Gemma 4 offline through Ollama (install Ollama, then: ollama pull gemma4:e2b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# 1 = let Gemma reword answers (every number is checked); 0 = template text only
ECOMETRIC_NARRATE=1
LLM_TIMEOUT=60

# Upload limits
MAX_UPLOAD_MB=5
MAX_ROWS=100000
MAX_COLUMNS=60
